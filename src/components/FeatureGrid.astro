---
import Icon from "./Icon.astro";

const features = [
  {
    icon: "download",
    title: "One-click install",
    body: "Downloads the latest Tor Browser directly from the official Tor Project servers.",
  },
  {
    icon: "shield",
    title: "Automatic verification",
    body: "SHA-256 checksum and PGP signature verification against the Tor Browser Developers key before any file is installed.",
  },
  {
    icon: "terminal",
    title: "Cross-platform",
    body: "One source tree, three native builds for macOS, Linux, and Windows.",
  },
  {
    icon: "lock",
    title: "User or system install",
    body: "Install for just yourself with no special privileges, or system-wide for all users with a password.",
  },
  {
    icon: "check",
    title: "Dark and light mode",
    body: "Toggle themes from the header, no restart needed.",
  },
  {
    icon: "folder",
    title: "Transparent operations",
    body: "View commands panel logs every system command the installer runs. Passwords are never written to it.",
  },
];
---

<div class="grid grid--3">
  {features.map((f) => (
    <div class="feature card">
      <div class="feature__icon"><Icon name={f.icon as any} size={22} /></div>
      <h3>{f.title}</h3>
      <p>{f.body}</p>
    </div>
  ))}
</div>

<style>
  .feature { padding: 26px 24px; }
  .feature__icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--app-purple-soft);
    color: var(--app-purple-bright);
    margin-bottom: 14px;
  }
  .feature h3 { margin-bottom: 6px; font-size: 1.08rem; color: var(--tor-dark-grey); }
  .feature p { color: var(--text-muted); font-size: 0.94rem; margin: 0; }
</style>
