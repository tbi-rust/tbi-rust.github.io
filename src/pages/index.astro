---
import Layout from "../layouts/Layout.astro";
import AppMockCard from "../components/AppMockCard.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import PipelineSteps from "../components/PipelineSteps.astro";
import Icon from "../components/Icon.astro";
import { base } from "../lib/base";
---

<Layout title="Home">
  <section class="hero section">
    <div class="container hero__grid">
      <div class="hero__copy">
        <span class="eyebrow"><Icon name="lock" size={14} /> Unofficial &middot; Rust + egui</span>
        <h1>Install Tor Browser properly.</h1>
        <p class="lede">
          One click. The app downloads the latest Tor Browser directly from the 
          official servers, shows you the file details, verifies the checksum and 
          signature, then installs it. Every command is logged so you can see exactly 
          what happened.
        </p>
        <div class="hero__actions">
          <a class="btn btn--ghost" href={`${base}install`}>Build from source</a>
        </div>
        <p class="hero__note">
          <Icon name="beta" size={14} /> Beta software.
        </p>
      </div>
      <div class="hero__visual">
        <AppMockCard />
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <span class="eyebrow">The problem</span>
      <h2>Tor Browser does not have a proper installer. This is one.</h2>
      <p class="lede" style="max-width: 62ch;">
        You download Tor Browser and get a folder to extract or an app to drag into 
        <code>/Applications</code>. No verification, no proper installation. This tool 
        does what should have been done from the start: download, verify, install, 
        launch. No manual steps, no scripts to trust blindly.
      </p>
      <div style="margin-top: 40px;">
        <FeatureGrid />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">How it works</span>
      <h2>Seven steps, every time, no exceptions.</h2>
      <p class="lede" style="max-width: 62ch; margin-bottom: 32px;">
        This is the actual code path in <code>install.rs</code>. Not a simplified version, 
        not marketing speak. The real pipeline.
      </p>
      <PipelineSteps />
    </div>
  </section>

  <section class="section section--deep">
    <div class="container security-teaser">
      <div>
        <span class="eyebrow" style="color:#e3cbfb;"><Icon name="shield" size={14} /> Security</span>
        <h2>Verify first. Install second. Never the other way around.</h2>
        <p style="max-width: 56ch;">
          Downloads happen over HTTPS, not Tor, so observers can see you fetched Tor Browser. 
          But nothing gets installed until both the SHA-256 hash and PGP signature check out. 
          If either fails, the install stops dead. No partial installs, no exceptions.
        </p>
        <a class="btn btn--onlight" href={`${base}security`}>Full security details &rarr;</a>
      </div>
      <div class="security-teaser__fingerprint">
        <span class="eyebrow" style="color:#e3cbfb;">Tor Browser Developers key</span>
        <p class="mono">EF6E 286D DA85 EA2A 4BA7<br />DE68 4E2C 6E87 9329 8290</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    padding-block: 24px;
  }
  .hero__actions { display: flex; gap: 14px; flex-wrap: wrap; margin: 28px 0 14px; }
  .hero__note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--app-text-secondary);
  }
  .hero__visual { display: flex; justify-content: center; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
  }

  .security-teaser {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 40px;
    align-items: center;
  }
  .security-teaser__fingerprint {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: var(--radius-md);
    padding: 20px 22px;
  }
  .security-teaser__fingerprint p { color: #f3e9fb; font-size: 0.86rem; line-height: 1.7; margin: 8px 0 0; }
  @media (max-width: 900px) {
    .security-teaser { grid-template-columns: 1fr; }
  }
</style>
