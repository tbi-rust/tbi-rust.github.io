---
import Layout from "../layouts/Layout.astro";
import PlatformCards from "../components/PlatformCards.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Install" description="Build and run Tor Browser Installer from source.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Get started</span>
      <h1>Installation</h1>
      
      <div class="notice">
        <p>
          Installation steps have moved. Please see the <a href="/docs/book">documentation</a> for up-to-date instructions.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .notice {
    margin-top: 24px;
    padding: 20px 24px;
    background: var(--app-purple-soft);
    border: 1px solid var(--app-border);
    border-radius: var(--radius-md);
    max-width: 62ch;
  }

  .notice p {
    margin: 0;
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .notice a {
    color: var(--app-purple-deep);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
