---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Install" description="Build and run Tor Browser Installer from source.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Get started</span>
      <h1>Installation</h1>
      
      <Notice type="info" style="margin-top: 32px;">
        <p>
          Installation steps have moved. Please visit the 
          <a href="/docs">documentation page</a> for up-to-date instructions.
        </p>
      </Notice>
    </div>
  </section>
</Layout>

<style>
  /* Page layout structural styles */
  .section {
    padding: 64px 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--app-purple-deep, #6b21a8);
    margin-bottom: 8px;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text, #111827);
    margin: 0 0 16px 0;
  }
</style>
