---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { base } from "../lib/base";
---

<Layout title="Comparison" description="How Tor Browser Installer compares to other installation methods.">
  <section class="section">
    <div class="container">
      <span class="eyebrow"><Icon name="balance" size={16} /> Comparison</span>
      <h1>How it compares to other methods</h1>
      <p class="lede" style="max-width: 68ch;">
        There are several ways to get Tor Browser running. Here's how this tool 
        stacks up against the alternatives.
      </p>

      <div class="comparison-grid" style="margin-top: 48px;">
        
        <!-- Official Download -->
        <div class="comparison-card">
          <div class="comparison-header">
            <h3>Official Tor Browser Download</h3>
            <span class="comparison-badge">Baseline</span>
          </div>
          <div class="comparison-body">
            <p>Download the browser bundle directly from torproject.org.</p>
            <ul class="comparison-features">
              <li class="feature-yes"><Icon name="check" size={16} /> Official, trusted source</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No verification (user must verify manually)</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No proper installer (extract folder or drag app)</li>
              <li class="feature-no"><Icon name="cross" size={16} /> Inconsistent across platforms</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No progress tracking</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No command logging</li>
            </ul>
          </div>
        </div>

        <!-- Tor Browser Launcher -->
        <div class="comparison-card">
          <div class="comparison-header">
            <h3>Tor Browser Launcher (Flatpak)</h3>
            <span class="comparison-badge">Linux only</span>
          </div>
          <div class="comparison-body">
            <p>Flatpak-based launcher that fetches, verifies, and installs Tor Browser.</p>
            <ul class="comparison-features">
              <li class="feature-yes"><Icon name="check" size={16} /> Automatic verification</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Proper installer</li>
              <li class="feature-no"><Icon name="cross" size={16} /> Linux only (Flatpak)</li>
              <li class="feature-no"><Icon name="cross" size={16} /> Runs in sandbox (Python + GTK)</li>
              <li class="feature-no"><Icon name="cross" size={16} /> Not native code</li>
              <li class="feature-no"><Icon name="cross" size={16} /> Requires Flatpak runtime</li>
            </ul>
          </div>
        </div>

        <!-- Manual Script -->
        <div class="comparison-card">
          <div class="comparison-header">
            <h3>Manual Shell Script</h3>
            <span class="comparison-badge">DIY</span>
          </div>
          <div class="comparison-body">
            <p>Write your own script to download and verify Tor Browser.</p>
            <ul class="comparison-features">
              <li class="feature-yes"><Icon name="check" size={16} /> Can verify downloads</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Can be cross-platform</li>
              <li class="feature-no"><Icon name="cross" size={16} /> User must write and maintain it</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No GUI (command-line only)</li>
              <li class="feature-no"><Icon name="cross" size={16} /> No progress tracking</li>
              <li class="feature-no"><Icon name="cross" size={16} /> User must trust the script</li>
            </ul>
          </div>
        </div>

        <!-- This Tool -->
        <div class="comparison-card comparison-card--featured">
          <div class="comparison-header">
            <h3>Tor Browser Installer</h3>
            <span class="comparison-badge comparison-badge--featured">This tool</span>
          </div>
          <div class="comparison-body">
            <p>Native Rust application that fetches, verifies, and installs Tor Browser.</p>
            <ul class="comparison-features">
              <li class="feature-yes"><Icon name="check" size={16} /> Automatic SHA-256 + PGP verification</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Proper installer with platform-native methods</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Cross-platform (macOS, Windows, Linux)</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Native code (Rust + egui)</li>
              <li class="feature-yes"><Icon name="check" size={16} /> No runtime dependencies</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Progress tracking</li>
              <li class="feature-yes"><Icon name="check" size={16} /> Full command logging</li>
              <li class="feature-yes"><Icon name="check" size={16} /> GUI with dark/light mode</li>
              <li class="feature-yes"><Icon name="check" size={16} /> User and system-wide install options</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="comparison-summary">
        <h2>Why use this instead?</h2>
        <div class="summary-grid">
          <div class="summary-item">
            <div class="summary-icon"><Icon name="shield" size={24} /></div>
            <h4>Security by default</h4>
            <p>Verification isn't an option you have to remember. It's built into the core workflow.</p>
          </div>
          <div class="summary-item">
            <div class="summary-icon"><Icon name="zap" size={24} /></div>
            <h4>Actually fast</h4>
            <p>Native Rust code, not interpreted Python. Downloads and verifies quickly.</p>
          </div>
          <div class="summary-item">
            <div class="summary-icon"><Icon name="globe" size={24} /></div>
            <h4>Works everywhere</h4>
            <p>Same experience on macOS, Windows, and Linux. No platform left behind.</p>
          </div>
          <div class="summary-item">
            <div class="summary-icon"><Icon name="eye" size={24} /></div>
            <h4>Fully transparent</h4>
            <p>Every command is logged. You can see exactly what the tool is doing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  
  .comparison-card {
    background: var(--surface);
    border: 1px solid var(--app-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-card);
  }
  
  .comparison-card--featured {
    border-color: var(--app-purple-bright);
    box-shadow: 0 0 0 3px rgba(149, 26, 209, 0.15);
  }
  
  .comparison-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--app-border);
  }
  
  .comparison-header h3 {
    margin: 0;
    color: var(--tor-dark-grey);
    font-size: 1.15rem;
  }
  
  .comparison-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--app-purple-soft);
    color: var(--app-purple-deep);
  }
  
  .comparison-badge--featured {
    background: var(--app-purple-bright);
    color: #fff;
  }
  
  .comparison-body p {
    color: var(--text-muted);
    margin: 0 0 16px 0;
    line-height: 1.6;
  }
  
  .comparison-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  
  .comparison-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    padding: 6px 10px;
    border-radius: 6px;
  }
  
  .feature-yes {
    color: var(--app-success);
    background: rgba(24, 163, 90, 0.08);
  }
  
  .feature-no {
    color: var(--app-error);
    background: rgba(200, 45, 60, 0.08);
  }
  
  .comparison-features li :global(svg) {
    flex: none;
  }
  
  .comparison-summary {
    margin-top: 64px;
    padding-top: 48px;
    border-top: 2px solid var(--app-border);
  }
  
  .comparison-summary h2 {
    text-align: center;
    margin-bottom: 32px;
  }
  
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }
  
  .summary-item {
    text-align: center;
    padding: 24px;
  }
  
  .summary-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: var(--app-purple-soft);
    color: var(--app-purple-bright);
    margin: 0 auto 16px;
  }
  
  .summary-icon :global(svg) {
    width: 2em;
    height: 2em;
  }
  
  .summary-item h4 {
    color: var(--app-purple-deep);
    margin: 0 0 8px 0;
    font-size: 1.1rem;
  }
  
  .summary-item p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  @media (max-width: 880px) {
    .comparison-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
